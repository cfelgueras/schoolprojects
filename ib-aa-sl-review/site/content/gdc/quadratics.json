          "screen": { "type": "text", "lines": ["Graph Func  :Y=", "Y1=X²-2X-4", "Y2=X+1", "Y3:", "Y4:", "Y5:"], "hl": 3, "fkeys": ["SEL", "DEL", "TYPE", "STYL", "MEM", "DRAW"] } },
