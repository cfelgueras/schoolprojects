  {
   "id": "distance",
   "title": "Distance between two points",
   "tool": "RUN•MAT √",
   "task": "Find the distance between $(1,\\ 1)$ and $(8,\\ 2)$.",
   "start": {
    "type": "text",
    "lines": []
   },
   "steps": [
    {
     "ask": "Which calculation gives the distance?",
     "options": [
      "$\\sqrt{(8-1)^2 + (2-1)^2}$",
      "$(8-1)^2 + (2-1)^2$",
      "$\\sqrt{(8-1) + (2-1)}$"
     ],
     "answer": 0,
     "why": "The distance formula (in the formula booklet) is $d = \\sqrt{(x_2-x_1)^2 + (y_2-y_1)^2}$."
    },
    {
     "do": "Press [[MENU]] to open the main menu.",
     "keys": [
      "MENU"
     ],
     "screen": {
      "type": "menu",
      "sel": "RUN•MAT"
     }
    },
    {
     "do": "**RUN•MAT** is already highlighted. Press [[EXE]].",
     "select": "RUN•MAT",
     "screen": {
      "type": "text",
      "lines": []
     }
    },
    {
     "do": "Start the square root: [[SHIFT]] [[x²]] (√ is written above x²).",
     "keys": [
      "SHIFT",
      "SQR"
     ],
     "hint": "√ is the yellow label above [[x²]]: press SHIFT first.",
     "entry": {
      "line": 0,
      "add": [
       "",
       "√("
      ]
     },
     "screen": {
      "type": "text",
      "lines": [
       "√("
      ],
      "right": [
       1
      ]
     }
    },
    {
     "do": "Type $(8-1)^2$: [[(]] `8` [[−]] `1` [[)]] [[x²]].",
     "keys": [
      "LP",
      "8",
      "SUB",
      "1",
      "RP",
      "SQR"
     ],
     "entry": {
      "line": 0,
      "prefix": "√("
     },
     "screen": {
      "type": "text",
      "lines": [
       "√((8-1)²"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "do": "Type $+(2-1)^2$ and close the root: [[+]] [[(]] `2` [[−]] `1` [[)]] [[x²]] [[)]], then [[EXE]].",
     "keys": [
      "ADD",
      "LP",
      "2",
      "SUB",
      "1",
      "RP",
      "SQR",
      "RP",
      "EXE"
     ],
     "entry": {
      "line": 0,
      "prefix": "√((8-1)²"
     },
     "screen": {
      "type": "text",
      "lines": [
       "√((8-1)²+(2-1)²)",
       "5√2"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "do": "In Math mode the answer is exact: $5\\sqrt{2}$. Press [[F↔D]] to see the decimal.",
     "keys": [
      "FD"
     ],
     "hint": "[[F↔D]] switches between the exact form and the decimal.",
     "screen": {
      "type": "text",
      "lines": [
       "√((8-1)²+(2-1)²)",
       "7.071067812"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "ask": "What do you write?",
     "options": [
      "$\\sqrt{50} = 5\\sqrt{2} \\approx 7.07$",
      "$7.071067812$",
      "$7.1$"
     ],
     "answer": 0,
     "why": "Exact if the question says so, otherwise 3 significant figures."
    }
   ],
   "result": "$d = \\sqrt{50} = 5\\sqrt{2} \\approx 7.07$. On Paper 1 you do the same by hand: $\\sqrt{49 + 1}$."
  },
  {
   "id": "gradient",
   "title": "Gradient from two points",
   "tool": "RUN•MAT",
   "task": "Find the gradient of the line through $(2,\\ -1)$ and $(6,\\ 7)$.",
   "start": {
    "type": "text",
    "lines": []
   },
   "steps": [
    {
     "ask": "Which calculation gives the gradient?",
     "options": [
      "$\\dfrac{7-(-1)}{6-2}$",
      "$\\dfrac{6-2}{7-(-1)}$",
      "$\\dfrac{7-1}{6-2}$"
     ],
     "answer": 0,
     "why": "$m = \\dfrac{y_2 - y_1}{x_2 - x_1}$: change in $y$ over change in $x$."
    },
    {
     "do": "In RUN•MAT type the top in brackets: [[(]] `7` [[−]] [[(-)]] `1` [[)]].",
     "keys": [
      "LP",
      "7",
      "SUB",
      "NEG",
      "1",
      "RP"
     ],
     "hint": "Subtract with [[−]], then make the 1 negative with [[(-)]]. Two different keys.",
     "entry": {
      "line": 0
     },
     "screen": {
      "type": "text",
      "lines": [
       "(7--1)"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "do": "Divide by the bottom: [[÷]] [[(]] `6` [[−]] `2` [[)]], then [[EXE]].",
     "keys": [
      "DIV",
      "LP",
      "6",
      "SUB",
      "2",
      "RP",
      "EXE"
     ],
     "hint": "Brackets around the bottom: without them the calculator works out $8 \\div 6 - 2$.",
     "entry": {
      "line": 0,
      "prefix": "(7--1)"
     },
     "screen": {
      "type": "text",
      "lines": [
       "(7--1)÷(6-2)",
       "2"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "ask": "A line is perpendicular to this one. What is its gradient?",
     "options": [
      "$-\\dfrac{1}{2}$",
      "$-2$",
      "$\\dfrac{1}{2}$"
     ],
     "answer": 0,
     "why": "Perpendicular gradients multiply to $-1$: $2 \\times \\left(-\\dfrac{1}{2}\\right) = -1$."
    }
   ],
   "result": "$m = \\dfrac{8}{4} = 2$; a perpendicular line has gradient $-\\dfrac{1}{2}$. Brackets around the top and the bottom are what make this work."
  },
