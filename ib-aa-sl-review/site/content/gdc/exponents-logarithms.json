  {
   "id": "log-base",
   "title": "Logarithm with any base",
   "tool": "RUN•MAT → MATH logab",
   "task": "Evaluate $\\log_5 12$.",
   "start": {
    "type": "text",
    "lines": []
   },
   "steps": [
    {
     "do": "Press [[MENU]] to open the main menu.",
     "keys": [
      "MENU"
     ],
     "screen": {
      "type": "menu",
      "sel": "RUN•MAT"
     }
    },
    {
     "do": "**RUN•MAT** is already highlighted. Press [[EXE]].",
     "select": "RUN•MAT",
     "screen": {
      "type": "text",
      "lines": []
     }
    },
    {
     "do": "Press [[F4]] **MATH**.",
     "keys": [
      "F4"
     ],
     "hint": "In Math input mode, MATH is on [[F4]].",
     "screen": {
      "type": "text",
      "lines": [
       ""
      ],
      "right": [
       1
      ],
      "fkeys": [
       "MAT",
       "logab",
       "Abs",
       "FRAC",
       "d/dx",
       "▷"
      ]
     }
    },
    {
     "do": "Press [[F2]] **logab**, type the base `5`, press [[▶]] to move to the second box, type `12`, then [[EXE]].",
     "keys": [
      "F2",
      "5",
      "RIGHT",
      "1",
      "2",
      "EXE"
     ],
     "hint": "[[▶]] moves the cursor from the base box to the number box.",
     "entry": {
      "line": 0,
      "add": [
       "log",
       "₅",
       "(",
       null,
       null,
       null
      ]
     },
     "screen": {
      "type": "text",
      "lines": [
       "log₅(12)",
       "1.543959311"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "ask": "Check with change of base. Which is equal to $\\log_5 12$?",
     "options": [
      "$\\dfrac{\\ln 12}{\\ln 5}$",
      "$\\dfrac{\\ln 5}{\\ln 12}$",
      "$\\ln 12 - \\ln 5$"
     ],
     "answer": 0,
     "why": "Change of base (formula booklet): $\\log_a b = \\dfrac{\\ln b}{\\ln a}$."
    },
    {
     "do": "Type [[ln]] `12` [[÷]] [[ln]] `5` and press [[EXE]].",
     "keys": [
      "LN",
      "1",
      "2",
      "DIV",
      "LN",
      "5",
      "EXE"
     ],
     "entry": {
      "line": 2
     },
     "screen": {
      "type": "text",
      "lines": [
       "log₅(12)",
       "1.543959311",
       "ln 12÷ln 5",
       "1.543959311"
      ],
      "right": [
       1,
       3
      ]
     }
    }
   ],
   "result": "$\\log_5 12 \\approx 1.54$. Both methods give the same value."
  },
  {
   "id": "solve-log",
   "title": "Exponential equation with ln",
   "tool": "RUN•MAT ln",
   "task": "Solve $3^x = 20$.",
   "start": {
    "type": "text",
    "lines": []
   },
   "steps": [
    {
     "ask": "Take $\\ln$ of both sides. What is $x$?",
     "options": [
      "$x = \\dfrac{\\ln 20}{\\ln 3}$",
      "$x = \\ln 20 - \\ln 3$",
      "$x = \\dfrac{20}{3}$"
     ],
     "answer": 0,
     "why": "$\\ln 3^x = x \\ln 3$, so $x \\ln 3 = \\ln 20$ and $x = \\dfrac{\\ln 20}{\\ln 3}$."
    },
    {
     "do": "Press [[MENU]] to open the main menu.",
     "keys": [
      "MENU"
     ],
     "screen": {
      "type": "menu",
      "sel": "RUN•MAT"
     }
    },
    {
     "do": "**RUN•MAT** is already highlighted. Press [[EXE]].",
     "select": "RUN•MAT",
     "screen": {
      "type": "text",
      "lines": []
     }
    },
    {
     "do": "Type [[ln]] `20` [[÷]] [[ln]] `3`, then [[EXE]].",
     "keys": [
      "LN",
      "2",
      "0",
      "DIV",
      "LN",
      "3",
      "EXE"
     ],
     "entry": {
      "line": 0
     },
     "screen": {
      "type": "text",
      "lines": [
       "ln 20÷ln 3",
       "2.726833028"
      ],
      "right": [
       1
      ]
     }
    },
    {
     "ask": "Write the answer.",
     "options": [
      "$x \\approx 2.73$",
      "$x = 2.726833028$",
      "$x \\approx 2.72$"
     ],
     "answer": 0,
     "why": "Three significant figures: 2.7268… rounds up to 2.73."
    }
   ],
   "result": "$x = \\dfrac{\\ln 20}{\\ln 3} \\approx 2.73$. On Paper 1 leave it as $\\dfrac{\\ln 20}{\\ln 3}$ or $\\log_3 20$."
  },
