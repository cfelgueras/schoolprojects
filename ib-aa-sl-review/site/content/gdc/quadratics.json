{
  "topic": "quadratics",
  "calculator": "Casio fx-9860GII / GIII",
  "lessons": [
    {
      "id": "equa",
      "title": "Solve with EQUA",
      "tool": "EQUA → POLY",
      "task": "Solve $2x^2 - 7x + 1 = 0$.",
      "start": { "type": "text", "lines": [] },
      "steps": [
        { "do": "Press [[MENU]] to open the main menu.", "keys": ["MENU"],
          "screen": { "type": "menu", "sel": "RUN•MAT" } },
        { "do": "Use the arrow keys to highlight **EQUA**, then press [[EXE]].", "select": "EQUA",
          "hint": "EQUA is in the third row of icons.",
          "screen": { "type": "text", "lines": ["F1:Simultaneous", "F2:Polynomial", "F3:Solver"], "fkeys": ["SIML", "POLY", "SOLV"] } },
        { "do": "Press [[F2]] **POLY** (polynomial equation).", "keys": ["F2"],
          "hint": "The F-keys match the labels at the bottom of the screen.",
          "screen": { "type": "text", "lines": ["Polynomial", "", "Degree?"], "fkeys": ["2", "3"] } },
        { "do": "Press [[F1]] to choose degree **2** ($ax^2 + bx + c$).", "keys": ["F1"],
          "screen": { "type": "text", "lines": ["aX²+bX+c=0", "     a     b     c", "1    0     0     0"], "fkeys": ["SOLV", "DEL", "CLR", "EDIT"] } },
        { "do": "Type $a$: `2`, then [[EXE]].", "keys": ["2", "EXE"],
          "screen": { "type": "text", "lines": ["aX²+bX+c=0", "     a     b     c", "1    2     0     0"], "fkeys": ["SOLV", "DEL", "CLR", "EDIT"] } },
        { "do": "Type $b$: [[(-)]] `7`, then [[EXE]].", "keys": ["NEG", "7", "EXE"],
          "hint": "For a negative number use the **(−)** key next to EXE, not the minus key.",
          "screen": { "type": "text", "lines": ["aX²+bX+c=0", "     a     b     c", "1    2    -7     0"], "fkeys": ["SOLV", "DEL", "CLR", "EDIT"] } },
        { "do": "Type $c$: `1`, then [[EXE]].", "keys": ["1", "EXE"],
          "screen": { "type": "text", "lines": ["aX²+bX+c=0", "     a     b     c", "1    2    -7     1"], "fkeys": ["SOLV", "DEL", "CLR", "EDIT"] } },
        { "do": "Press [[F1]] **SOLV**.", "keys": ["F1"],
          "screen": { "type": "text", "lines": ["aX²+bX+c=0", "", "X1   3.350781059", "X2   0.1492189408"], "fkeys": ["REPT"] } },
        { "ask": "What do you write on Paper 2?",
          "options": ["$x \\approx 3.35$ or $x \\approx 0.149$", "$x = 3.350781059$ or $x = 0.1492189408$", "$x \\approx 3.3$ or $x \\approx 0.14$"],
          "answer": 0,
          "why": "Give answers to 3 significant figures. In 0.149 the first zero does not count, so three figures are 1, 4 and 9." }
      ],
      "result": "$2x^2 - 7x + 1 = 0 \\Rightarrow x \\approx 3.35$ or $x \\approx 0.149$. Write the equation down first: key presses are not accepted as working."
    },
    {
      "id": "roots",
      "title": "Graph and find the roots",
      "tool": "GRAPH → G-Solv ROOT",
      "task": "Draw $f(x) = x^2 - 2x - 4$ and find its roots.",
      "start": { "type": "text", "lines": [] },
      "steps": [
        { "do": "Press [[MENU]] to open the main menu.", "keys": ["MENU"],
          "screen": { "type": "menu", "sel": "RUN•MAT" } },
        { "do": "Highlight **GRAPH** and press [[EXE]].", "select": "GRAPH",
          "hint": "GRAPH is the first icon of the second row.",
          "screen": { "type": "text", "lines": ["Graph Func  :Y=", "Y1:", "Y2:", "Y3:", "Y4:", "Y5:"], "hl": 1, "fkeys": ["SEL", "DEL", "TYPE", "STYL", "MEM", "DRAW"] } },
        { "do": "On the Y1 line type $x^2 - 2x - 4$: [[X,θ,T]] [[x²]] [[−]] `2` [[X,θ,T]] [[−]] `4`, then [[EXE]].",
          "keys": ["XT", "SQR", "SUB", "2", "XT", "SUB", "4", "EXE"], "entry": { "line": 1, "prefix": "Y1:" },
          "hint": "[[X,θ,T]] gives the variable $x$. Here you want the **minus** key [[−]], not (−).",
          "screen": { "type": "text", "lines": ["Graph Func  :Y=", "Y1=X²-2X-4", "Y2:", "Y3:", "Y4:", "Y5:"], "hl": 2, "fkeys": ["SEL", "DEL", "TYPE", "STYL", "MEM", "DRAW"] } },
        { "do": "Open the view window: [[SHIFT]] then [[F3]] **V-WIN**.", "keys": ["SHIFT", "F3"],
          "hint": "V-WIN is written above F3. Press SHIFT first, then F3.",
          "screen": { "type": "text", "lines": ["View Window", "Xmin :-5", " max :7", " scale:1", "Ymin :-6", " max :6", " scale:1"], "hl": 1, "fkeys": ["INIT", "TRIG", "STD", "STO", "RCL"] } },
        { "do": "The window is set to $-5 \\le x \\le 7$, $-6 \\le y \\le 6$, so you can see both roots and the vertex. (On your calculator, type each value and press [[EXE]].) Press [[EXIT]].", "keys": ["EXIT"],
          "screen": { "type": "text", "lines": ["Graph Func  :Y=", "Y1=X²-2X-4", "Y2:", "Y3:", "Y4:", "Y5:"], "hl": 1, "fkeys": ["SEL", "DEL", "TYPE", "STYL", "MEM", "DRAW"] } },
        { "do": "Press [[F6]] **DRAW**.", "keys": ["F6"],
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"] } },
        { "do": "Open the graph-solving menu: [[SHIFT]] [[F5]] **G-SOLV**.", "keys": ["SHIFT", "F5"],
          "hint": "G-SOLV is written above F5.",
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"], "fkeys": ["ROOT", "MAX", "MIN", "Y-ICPT", "ISCT", "▷"] } },
        { "do": "Press [[F1]] **ROOT**.", "keys": ["F1"],
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"], "pt": [-1.236067977, 0], "label": "ROOT", "read": "X=-1.236067977  Y=0" } },
        { "do": "Press [[▶]] to jump to the next root.", "keys": ["RIGHT"],
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"], "pt": [3.236067977, 0], "label": "ROOT", "read": "X=3.236067977  Y=0" } },
        { "ask": "What are the roots, to 3 significant figures?",
          "options": ["$x \\approx -1.24$ and $x \\approx 3.24$", "$x \\approx -1.23$ and $x \\approx 3.23$", "$x = -1$ and $x = 3$"],
          "answer": 0,
          "why": "Round, don't cut: −1.236… rounds to −1.24 because the next digit is 6." }
      ],
      "result": "The roots of $x^2 - 2x - 4$ are $x \\approx -1.24$ and $x \\approx 3.24$. If a root is missing, change the V-Window: ROOT only finds roots that are on the screen."
    },
    {
      "id": "vertex",
      "title": "Find the vertex",
      "tool": "G-Solv MIN / MAX",
      "task": "Find the vertex of $f(x) = x^2 - 2x - 4$. The graph is already drawn.",
      "start": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"] },
      "steps": [
        { "ask": "Is the vertex a maximum or a minimum?",
          "options": ["A minimum: the parabola opens upwards", "A maximum: the parabola opens downwards"],
          "answer": 0,
          "why": "$a = 1 > 0$, so the parabola opens upwards and the vertex is its lowest point." },
        { "do": "Open G-SOLV: [[SHIFT]] [[F5]].", "keys": ["SHIFT", "F5"],
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"], "fkeys": ["ROOT", "MAX", "MIN", "Y-ICPT", "ISCT", "▷"] } },
        { "do": "Press [[F3]] **MIN**.", "keys": ["F3"],
          "hint": "MIN is above F3. MAX (F2) would be for a parabola that opens downwards.",
          "screen": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"], "pt": [1, -5], "label": "MIN", "read": "X=1  Y=-5" } },
        { "ask": "What is the vertex?",
          "options": ["$(1,\\ -5)$", "$(-5,\\ 1)$", "$(1,\\ -4)$"],
          "answer": 0,
          "why": "The calculator shows X = 1 and Y = −5, so the vertex is (1, −5) and the axis of symmetry is x = 1." }
      ],
      "result": "The vertex is $(1,\\ -5)$: a minimum. Use [[F2]] **MAX** when $a < 0$."
    },
    {
      "id": "y-values",
      "title": "y-intercept and f(x)",
      "tool": "G-Solv Y-ICPT, Y-CAL",
      "task": "For $f(x) = x^2 - 2x - 4$, find the $y$-intercept and $f(3)$. The graph is already drawn.",
      "unverified": true,
      "start": { "type": "graph", "win": [-5, 7, -6, 6], "fns": ["x*x-2*x-4"] },
